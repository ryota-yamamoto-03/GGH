# ==============================================
# GGH ライフポイント管理アプリ 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
#   cp .env.example .env
# ==============================================

# --- Supabase(プロジェクト設定 > API から取得)---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# --- Prisma 用 DB 接続文字列(Supabase > Settings > Database)---
# Transaction pooler(ポート 6543)を DATABASE_URL に、
# Direct connection(ポート 5432)を DIRECT_URL に設定します。
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- アプリ URL(Vercel 本番では本番 URL を設定)---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
